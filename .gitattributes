# Normalisation des fins de lignes : LF partout sauf fichiers binaires

* text=auto eol=lf

# Texte explicitement en LF
*.md        text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.tex       text eol=lf
*.sty       text eol=lf
*.lua       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf

# Binaires — pas de conversion
*.pdf       binary
*.png       binary
*.docx      binary
*.jpg       binary
*.svg       text eol=lf
