[sqlfluff]
# Dialecte principal du projet (syntaxe Oracle pour les corrections SQL)
dialect = oracle
# Largeur max des lignes — les commentaires descriptifs des questions sont souvent longs
max_line_length = 200

# Règles désactivées (non pertinentes pour des corrections SQL pédagogiques) :
#   CP02 (capitalisation.identifiers) — le schéma utilise le camelCase (numEt, moyTest, coefCC…)
#   AM05 (ambiguous.join)             — JOIN sans INNER/LEFT montré volontairement
#   AL05 (aliasing.unique.table)      — alias courts (E, N, M) réutilisés entre requêtes
#   LT09 (layout.select_targets)      — SELECT col1, col2 sur une ligne autorisé
#   ST05 (structure.subquery)          — sous-requêtes IN sans qualification
exclude_rules = capitalisation.identifiers, aliasing.unique.table, layout.select_targets, structure.subquery

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space
indented_joins = True
indented_using_on = True
indented_on_contents = True
indented_ctes = True
implicit_indents = allow

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True

[sqlfluff:rules:aliasing.expression]
allow_scalar = True
